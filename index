// Orders characters so members of the same group sit next to each other in
// the angular sequence, which is what makes them cluster visually.
function buildClusterOrder(chars){
  const groups = new Map(); // key -> array of chars, in first-seen order
  const order = [];
  chars.forEach(c=>{
    const g = (c.gruppe||'').trim();
    if(!g){ order.push({group:null, char:c}); return; }
    if(!groups.has(g)) groups.set(g, []);
    groups.get(g).push(c);
  });
  // interleave: walk chars again, emit group blocks the first time we see that group
  const emitted = new Set();
  const finalOrder = [];
  chars.forEach(c=>{
    const g = (c.gruppe||'').trim();
    if(!g){ finalOrder.push(c); return; }
    if(emitted.has(g)) return;
    emitted.add(g);
    groups.get(g).forEach(m=>finalOrder.push(m));
  });
  return finalOrder;
}

function renderNetwork(){
  const svg = document.getElementById('netSvg');
  const emptyEl = document.getElementById('netEmpty');
  if(charsCache.length===0){
    svg.innerHTML = '';
    emptyEl.style.display = 'block';
    return;
  }
  emptyEl.style.display = 'none';

  const cx=320, cy=320, baseRing=170, burtonR=48, nodeR=32;
  const ordered = buildClusterOrder(charsCache);
  const n = ordered.length;
  const positions = {burton:{x:cx,y:cy,r:burtonR}};
  const angleOf = {};

  ordered.forEach((c,i)=>{
    const angle = (i/n)*2*Math.PI - Math.PI/2;
    const r = Math.max(95, Math.min(300, baseRing * statusMeta(c.status).closeness));
    angleOf[c.ts] = angle;
    positions[c.ts] = polar(cx,cy,angle,r);
    positions[c.ts].r = nodeR;
  });

  let defs = '<defs>';
  let blobs = '';
  let edges = '';
  let nodes = '';

  // group blobs (behind everything)
  const groupMap = new Map();
  ordered.forEach(c=>{
    const g = (c.gruppe||'').trim();
    if(!g) return;
    if(!groupMap.has(g)) groupMap.set(g, []);
    groupMap.get(g).push(c);
  });
  groupMap.forEach((members, gname)=>{
    if(members.length < 2) return;
    const angles = members.map(m=>angleOf[m.ts]);
    const radii = members.map(m=>{ const p=positions[m.ts]; return Math.hypot(p.x-cx,p.y-cy); });
    const angPad = (Math.PI/ n) * 0.75;
    const aMin = Math.min(...angles) - angPad;
    const aMax = Math.max(...angles) + angPad;
    const rMin = Math.max(50, Math.min(...radii) - 46);
    const rMax = Math.max(...radii) + 46;
    const color = groupColor(gname);
    const oOuter1 = polar(cx,cy,aMin,rMax), oOuter2 = polar(cx,cy,aMax,rMax);
    const oInner1 = polar(cx,cy,aMax,rMin), oInner2 = polar(cx,cy,aMin,rMin);
    const largeArc = (aMax-aMin) > Math.PI ? 1 : 0;
    const path = `M ${oOuter1.x} ${oOuter1.y} A ${rMax} ${rMax} 0 ${largeArc} 1 ${oOuter2.x} ${oOuter2.y}
      L ${oInner1.x} ${oInner1.y} A ${rMin} ${rMin} 0 ${largeArc} 0 ${oInner2.x} ${oInner2.y} Z`;
    blobs += `<path d="${path}" fill="${color}" fill-opacity="0.10" stroke="${color}" stroke-opacity="0.45" stroke-width="1.5"/>`;
    const midAngle = (aMin+aMax)/2;
    const labelPos = polar(cx,cy,midAngle,rMax+16);
    blobs += `<text x="${labelPos.x}" y="${labelPos.y}" text-anchor="middle" style="font-family:'Share Tech Mono',monospace;font-size:11px;fill:${color};letter-spacing:1px;text-transform:uppercase;">${escapeHtml(gname)}</text>`;
  });

  // edges: burton -> each character
  charsCache.forEach(c=>{
    const p = positions[c.ts];
    const color = statusMeta(c.status).color;
    edges += `<line x1="${cx}" y1="${cy}" x2="${p.x}" y2="${p.y}" stroke="${color}" stroke-width="2" opacity="0.55"/>`;
  });
  // edges: custom connections between characters
  connsCache.forEach(cn=>{
    const a = positions[cn.fromId], b = positions[cn.toId];
    if(!a || !b) return;
    const color = statusMeta(cn.status).color;
    edges += `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${color}" stroke-width="1.6" stroke-dasharray="5,4" opacity="0.6"/>`;
  });

  nodes += burtonNodeSvg(cx,cy,burtonR);

  charsCache.forEach(c=>{
    const p = positions[c.ts];
    const color = statusMeta(c.status).color;
    const clipId = 'clip'+c.ts;
    if(c.image){
      defs += `<clipPath id="${clipId}"><circle cx="${p.x}" cy="${p.y}" r="${nodeR}"/></clipPath>`;
    }
    nodes += `<g class="net-node" onclick="selectChar(${c.ts})">`;
    if(c.image){
      nodes += `<image href="${c.image}" x="${p.x-nodeR}" y="${p.y-nodeR}" width="${nodeR*2}" height="${nodeR*2}" clip-path="url(#${clipId})" preserveAspectRatio="xMidYMid slice"/>`;
      nodes += `<circle class="ring" cx="${p.x}" cy="${p.y}" r="${nodeR}" fill="none" stroke="${color}" stroke-width="3"/>`;
    } else {
      nodes += `<circle class="ring" cx="${p.x}" cy="${p.y}" r="${nodeR}" fill="${color}" fill-opacity="0.25" stroke="${color}" stroke-width="3"/>`;
      nodes += `<text class="net-initials" x="${p.x}" y="${p.y}">${initials(c.name)}</text>`;
    }
    nodes += `<text class="net-label" x="${p.x}" y="${p.y+nodeR+18}">${escapeHtml(c.name.split(' ')[0])}</text>`;
    nodes += `</g>`;
  });

  defs += '</defs>';
  svg.innerHTML = defs + blobs + edges + nodes;
}

function burtonNodeSvg(cx,cy,r){
  return `<g class="net-node" onclick="selectChar('burton')">
    <circle class="ring" cx="${cx}" cy="${cy}" r="${r}" fill="url(#burtonGrad)" stroke="#fff" stroke-width="2"/>
    <text class="net-initials" x="${cx}" y="${cy}" style="font-size:14px;">BURTON</text>
  </g>
  <radialGradient id="burtonGrad" cx="50%" cy="40%" r="65%">
    <stop offset="0%" stop-color="#ff2ee8"/>
    <stop offset="100%" stop-color="#9d4edd"/>
  </radialGradient>`;
}

function selectChar(ts){
  selectedCharTs = ts;
  const detail = document.getElementById('charDetail');
  if(ts==='burton'){
    detail.style.display='flex';
    detail.innerHTML = `
      <button class="char-detail-close" onclick="closeDetail()">✕ schließen</button>
      <div class="avatar-lg initials-lg" style="background:linear-gradient(135deg,#ff2ee8,#9d4edd);">BM</div>
      <div class="char-detail-body">
        <div class="rel-name">Burton Mc Haggys</div>
        <div class="rel-role">Zentrum des Netzes — alle Verbindungen laufen über ihn.</div>
      </div>`;
    return;
  }
  const c = charsCache.find(x=>x.ts===ts);
  if(!c) return;
  const meta = statusMeta(c.status);
  const relatedConns = connsCache.filter(cn=>cn.fromId===ts||cn.toId===ts);
  const connHtml = relatedConns.map(cn=>{
    const other = charsCache.find(x=>x.ts===(cn.fromId===ts?cn.toId:cn.fromId));
    if(!other) return '';
    const cm = statusMeta(cn.status);
    return `<div style="margin-top:4px;font-size:13.5px;color:var(--text-dim);">↔ ${escapeHtml(other.name)}: <span style="color:${cm.color}">${escapeHtml(cn.label||cm.label)}</span></div>`;
  }).join('');
  detail.style.display='flex';
  detail.innerHTML = `
    <button class="char-detail-close" onclick="closeDetail()">✕ schließen</button>
    ${c.image ? `<img class="avatar-lg" src="${c.image}">` : `<div class="avatar-lg initials-lg" style="background:${meta.color};">${initials(c.name)}</div>`}
    <div class="char-detail-body">
      <div class="rel-name">${escapeHtml(c.name)}</div>
      <div class="rel-role">${escapeHtml(c.role||'')}${c.gruppe?' · '+escapeHtml(c.gruppe):''}</div>
      <span class="rel-status" style="border:1px solid ${meta.color};color:${meta.color};">${meta.label} von Burton</span>
      <div class="rel-notes" style="margin-top:8px;">${escapeHtml(c.notes||'')}</div>
      ${connHtml}
      <div style="margin-top:10px;">
        <button class="ghost" onclick="startEditCharacter(${c.ts})">bearbeiten</button>
        <button class="ghost" onclick="deleteCharacter(${c.ts})">löschen</button>
      </div>
    </div>`;
}
function closeDetail(){
  document.getElementById('charDetail').style.display='none';
  selectedCharTs = null;
}

async function addRelationship(){
  const name = document.getElementById('relName').value.trim();
  if(!name) return;
  if(!(await verifyPin())) return;
  const role = document.getElementById('relRole').value.trim();
  const status = document.getElementById('relStatus').value;
  const gruppe = document.getElementById('relGroup').value.trim();
  const notes = document.getElementById('relNotes').value.trim();
  const wasEditing = editingCharTs !== null;
  const ts = wasEditing ? editingCharTs : Date.now();
  const existing = wasEditing ? syncState.characters.find(c=>c.ts===editingCharTs) : null;
  const image = pendingImage !== null ? pendingImage : (existing ? existing.image : null);
  const record = {ts,name,role,status,gruppe,notes,image};
  if(wasEditing){
    const idx = syncState.characters.findIndex(c=>c.ts===editingCharTs);
    if(idx>=0) syncState.characters[idx] = record; else syncState.characters.push(record);
  } else {
    syncState.characters.push(record);
  }
  await saveSyncState();
  resetCharForm();
  await refreshNetwork();
  if(wasEditing) selectChar(ts);
}

function resetCharForm(){
  document.getElementById('relName').value='';
  document.getElementById('relRole').value='';
  document.getElementById('relGroup').value='';
  document.getElementById('relNotes').value='';
  document.getElementById('relImage').value='';
  document.getElementById('imgPreview').style.display='none';
  document.getElementById('imgUploadLabel').textContent='Bild wählen (optional)';
  document.getElementById('relStatus').value='neutral';
  pendingImage = null;
  editingCharTs = null;
  document.getElementById('charFormTitle').textContent = 'Charakter hinzufügen';
  document.getElementById('charFormSaveBtn').textContent = 'Zum Netz hinzufügen';
  document.getElementById('charFormCancelBtn').style.display = 'none';
}

function startEditCharacter(ts){
  const c = charsCache.find(x=>x.ts===ts);
  if(!c) return;
  editingCharTs = ts;
  pendingImage = null;
  document.getElementById('relName').value = c.name;
  document.getElementById('relRole').value = c.role||'';
  document.getElementById('relGroup').value = c.gruppe||'';
  document.getElementById('relNotes').value = c.notes||'';
  document.getElementById('relStatus').value = c.status;
  document.getElementById('imgPreview').style.display = c.image ? 'inline-block' : 'none';
  if(c.image) document.getElementById('imgPreview').src = c.image;
  document.getElementById('imgUploadLabel').textContent = c.image ? 'Neues Bild wählen (optional)' : 'Bild wählen (optional)';
  document.getElementById('charFormTitle').textContent = 'Charakter bearbeiten: ' + c.name;
  document.getElementById('charFormSaveBtn').textContent = 'Änderungen speichern';
  document.getElementById('charFormCancelBtn').style.display = 'inline-block';
  closeDetail();
  document.getElementById('charFormTitle').scrollIntoView({behavior:'smooth', block:'center'});
}

function cancelEditCharacter(){
  resetCharForm();
}

async function deleteCharacter(ts){
  if(!(await verifyPin())) return;
  syncState.characters = syncState.characters.filter(c=>c.ts!==ts);
  syncState.connections = syncState.connections.filter(cn=>cn.fromId!==ts && cn.toId!==ts);
  await saveSyncState();
  closeDetail();
  await refreshNetwork();
}

async function addConnection(){
  const fromId = Number(document.getElementById('connFrom').value);
  const toId = Number(document.getElementById('connTo').value);
  if(!fromId || !toId || fromId===toId) return;
  if(!(await verifyPin())) return;
  const label = document.getElementById('connLabel').value.trim();
  const status = document.getElementById('connStatus').value;
  syncState.connections.push({ts:Date.now(), fromId, toId, label, status});
  await saveSyncState();
  document.getElementById('connLabel').value='';
  await refreshNetwork();
}
async function deleteConnection(ts){
  if(!(await verifyPin())) return;
  syncState.connections = syncState.connections.filter(cn=>cn.ts!==ts);
  await saveSyncState();
  await refreshNetwork();
}

function renderConnList(){
  const listEl = document.getElementById('connList');
  if(connsCache.length===0){ listEl.innerHTML=''; return; }
  listEl.innerHTML = connsCache.map(cn=>{
    const a = charsCache.find(x=>x.ts===cn.fromId);
    const b = charsCache.find(x=>x.ts===cn.toId);
    if(!a||!b) return '';
    const cm = statusMeta(cn.status);
    return `<div class="conn-item">
      <span>${escapeHtml(a.name)} ↔ ${escapeHtml(b.name)} — <span style="color:${cm.color}">${escapeHtml(cn.label||cm.label)}</span></span>
      <button class="ghost" onclick="deleteConnection(${cn.ts})">löschen</button>
    </div>`;
  }).join('');
}

async function refreshNetwork(){
  loadCharacters();
  loadConnections();
  populateConnSelects();
  renderNetwork();
  renderConnList();
}

async function initApp(){
  const ready = await loadSyncState();
  if(!ready) return; // setup banner is showing, nothing else to render
  loadJournal();
  await refreshNetwork();
}
loadProfile();
initApp();

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}
</script>
</body>
</html>
