function statusMeta(key){ return STATUS_META[key] || STATUS_META.neutral; }
function groupColor(name){
  let h=0; for(let i=0;i<name.length;i++) h = (h*31 + name.charCodeAt(i)) >>> 0;
  return GROUP_PALETTE[h % GROUP_PALETTE.length];
}
function polar(cx,cy,angle,r){ return {x: cx + r*Math.cos(angle), y: cy + r*Math.sin(angle)}; }

