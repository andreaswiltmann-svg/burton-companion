const SYNC_ID = ''; // <- filled in by Claude once a store has been created
const SYNC_API = 'https://jsonblob.com/api/jsonBlob/';
const DEFAULT_SYNC_STATE = { journal: [], characters: [], connections: [], settings: { editPin: null } };
let syncState = null;

async function createSyncStore(){
  try{
    const res = await fetch('https://jsonblob.com/api/jsonBlob', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(DEFAULT_SYNC_STATE)
    });
    if(!res.ok){
      alert('Server antwortete mit Fehler ' + res.status + ' ' + res.statusText);
      return;
    }
    const loc = res.headers.get('Location') || res.url;
    if(!loc){
      alert('Speicher wurde erstellt, aber keine ID zurückbekommen (Location-Header fehlt/blockiert). Versuch\'s über einen anderen Browser oder ohne Werbeblocker.');
      return;
    }
    const id = loc.split('/').filter(Boolean).pop();
    document.getElementById('syncIdResult').style.display='block';
    document.getElementById('syncIdBox').textContent = id;
  }catch(e){
    alert('FEHLERDETAIL: ' + e.name + ' — ' + e.message + '\n\nDas ist wahrscheinlich ein CORS- oder Netzwerkblock. Schick mir diesen Text.');
  }
}

async function loadSyncState(){
  if(!SYNC_ID){
    document.body.classList.add('sync-pending');
    document.getElementById('syncSetup').style.display='block';
    return false;
  }
  try{
    const res = await fetch(SYNC_API + SYNC_ID);
    if(!res.ok) throw new Error('not found');
    syncState = await res.json();
    syncState.journal = syncState.journal || [];
    syncState.characters = syncState.characters || [];
    syncState.connections = syncState.connections || [];
    syncState.settings = syncState.settings || {editPin:null};
    return true;
  }catch(e){
    syncState = JSON.parse(JSON.stringify(DEFAULT_SYNC_STATE));
    alert('Konnte den Cloud-Speicher nicht laden. Änderungen werden evtl. nicht dauerhaft gespeichert.');
    return true;
  }
}

async function saveSyncState(){
  if(!SYNC_ID || !syncState) return;
  try{
    await fetch(SYNC_API + SYNC_ID, {
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(syncState)
    });
  }catch(e){
    alert('Speichern fehlgeschlagen — Internetverbindung prüfen.');
