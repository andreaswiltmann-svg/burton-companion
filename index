<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Burton Mc Haggys — RP Companion</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#0a0612;
    --void-2:#140b22;
    --void-3:#1c1030;
    --neon-purple:#9d4edd;
    --neon-magenta:#ff2ee8;
    --neon-cyan:#00f0ff;
    --chrome:#c9ccd6;
    --chrome-dim:#726f85;
    --text:#e8e6f0;
    --text-dim:#a9a6bd;
    --line: rgba(201,204,214,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse at 20% -10%, rgba(157,78,221,0.18), transparent 55%),
      radial-gradient(ellipse at 90% 10%, rgba(0,240,255,0.10), transparent 50%),
      var(--void);
    color:var(--text);
    font-family:'Rajdhani',sans-serif;
    min-height:100vh;
    padding:28px 18px 60px;
  }
  .wrap{max-width:880px;margin:0 auto;}

  /* ---- signature: neon shop sign header ---- */
  .sign{
    text-align:center;
    padding:36px 20px 30px;
    position:relative;
  }
  .sign-frame{
    display:inline-block;
    padding:22px 46px;
    border:2px solid var(--neon-magenta);
    border-radius:6px;
    background: linear-gradient(180deg, rgba(255,46,232,0.06), rgba(0,240,255,0.03));
    box-shadow:
      0 0 6px rgba(255,46,232,0.6),
      0 0 22px rgba(255,46,232,0.35),
      inset 0 0 18px rgba(157,78,221,0.15);
    animation: flicker 6s infinite;
  }
  @keyframes flicker{
    0%,19%,21%,23%,80%,100%{opacity:1;}
    20%,22%{opacity:0.72;}
    81%{opacity:0.85;}
  }
  .sign h1{
    font-family:'Orbitron',sans-serif;
    font-weight:900;
    font-size:clamp(28px,5vw,44px);
    letter-spacing:3px;
    margin:0;
    color:#fff;
    text-shadow:
      0 0 6px var(--neon-magenta),
      0 0 18px var(--neon-magenta),
      0 0 42px var(--neon-purple);
  }
  .sign .sub{
    margin-top:10px;
    font-family:'Share Tech Mono',monospace;
    color:var(--neon-cyan);
    text-shadow:0 0 8px rgba(0,240,255,0.7);
    font-size:13px;
    letter-spacing:2px;
    text-transform:uppercase;
  }
  .sign .meta{
    margin-top:6px;
    color:var(--chrome-dim);
    font-size:13px;
    letter-spacing:1px;
  }

  /* ---- tabs ---- */
  nav.tabs{
    display:flex;
    gap:8px;
    justify-content:center;
    flex-wrap:wrap;
    margin:26px 0 20px;
  }
  nav.tabs button{
    font-family:'Orbitron',sans-serif;
    font-size:12px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    background:var(--void-2);
    color:var(--text-dim);
    border:1px solid var(--line);
    border-radius:4px;
    padding:11px 18px;
    cursor:pointer;
    transition:all .18s ease;
  }
  nav.tabs button:hover{
    color:var(--text);
    border-color:var(--neon-cyan);
  }
  nav.tabs button.active{
    color:#fff;
    border-color:var(--neon-purple);
    background:linear-gradient(180deg, rgba(157,78,221,0.22), rgba(157,78,221,0.06));
    box-shadow:0 0 14px rgba(157,78,221,0.45);
  }

  .panel{
    background:var(--void-2);
    border:1px solid var(--line);
    border-radius:10px;
    padding:26px 24px;
    display:none;
  }
  .panel.active{display:block; animation:fadeIn .25s ease;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

  h2.panel-title{
    font-family:'Orbitron',sans-serif;
    font-size:15px;
    letter-spacing:2px;
    text-transform:uppercase;
    color:var(--neon-cyan);
    margin:0 0 20px;
    text-shadow:0 0 10px rgba(0,240,255,0.4);
  }

  /* profile */
  .profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  @media(max-width:600px){.profile-grid{grid-template-columns:1fr;}}
  .stat-card{
    background:var(--void-3);
    border:1px solid var(--line);
    border-radius:8px;
    padding:14px 16px;
  }
  .stat-card .label{
    font-family:'Share Tech Mono',monospace;
    font-size:11px;
    color:var(--neon-magenta);
    letter-spacing:1.5px;
    text-transform:uppercase;
    margin-bottom:6px;
  }
  .stat-card .val{font-size:16px;font-weight:600;}
  .bio-block{margin-top:20px;}
  .bio-block h3{
    font-family:'Orbitron',sans-serif;
    font-size:12px;
    letter-spacing:1.5px;
    color:var(--neon-purple);
    text-transform:uppercase;
    margin:22px 0 8px;
  }
  .bio-block p{line-height:1.6;color:var(--text);font-size:15.5px;margin:0;}
  .tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;}
  .tag{
    font-family:'Share Tech Mono',monospace;
    font-size:12px;
    padding:5px 11px;
    border-radius:20px;
    border:1px solid var(--neon-cyan);
    color:var(--neon-cyan);
  }

  /* phrasebank */
  .search-row{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
  .search-row input, .filter-select{
    flex:1;
    min-width:160px;
    background:var(--void-3);
    border:1px solid var(--line);
    color:var(--text);
    padding:10px 14px;
    border-radius:6px;
    font-family:'Rajdhani',sans-serif;
    font-size:15px;
  }
  .filter-select{flex:none;}
  .search-row input:focus, .filter-select:focus, textarea:focus{outline:2px solid var(--neon-cyan); outline-offset:1px;}
  .phrase-cat{
    font-family:'Orbitron',sans-serif;
    font-size:12px;
    letter-spacing:1.5px;
    color:var(--neon-magenta);
    text-transform:uppercase;
    margin:22px 0 10px;
    border-bottom:1px solid var(--line);
    padding-bottom:6px;
  }
  .phrase-cat:first-of-type{margin-top:0;}
  .phrase{
    background:var(--void-3);
    border-left:3px solid var(--neon-purple);
    border-radius:0 6px 6px 0;
    padding:12px 14px;
    margin-bottom:8px;
    font-size:15.5px;
    line-height:1.5;
    position:relative;
    cursor:pointer;
  }
  .phrase:hover{border-left-color:var(--neon-cyan);}
  .phrase .stage{color:var(--text-dim);font-style:italic;font-size:13.5px;}
  .phrase .copied{
    position:absolute;right:10px;top:10px;
    font-family:'Share Tech Mono',monospace;
    font-size:11px;color:var(--neon-cyan);opacity:0;transition:opacity .2s;
  }
  .phrase.copied-flash .copied{opacity:1;}

  /* journal & relationships shared form styles */
  .entry-form{
    background:var(--void-3);
    border:1px solid var(--line);
    border-radius:8px;
    padding:16px;
    margin-bottom:22px;
  }
  .entry-form textarea, .entry-form input{
    width:100%;
    background:var(--void);
    border:1px solid var(--line);
    color:var(--text);
    padding:10px 12px;
    border-radius:6px;
    font-family:'Rajdhani',sans-serif;
    font-size:15px;
    margin-bottom:10px;
  }
  .entry-form textarea{min-height:70px;resize:vertical;}
  .form-row{display:flex;gap:10px;flex-wrap:wrap;}
  .form-row > *{flex:1;min-width:140px;}
  button.action{
    font-family:'Orbitron',sans-serif;
    font-size:12px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    background:linear-gradient(180deg, rgba(0,240,255,0.18), rgba(0,240,255,0.05));
    border:1px solid var(--neon-cyan);
    color:#fff;
    padding:10px 20px;
    border-radius:6px;
    cursor:pointer;
    transition:.18s;
  }
  button.action:hover{box-shadow:0 0 14px rgba(0,240,255,0.5);}
  button.ghost{
    background:transparent;
    border:1px solid var(--line);
    color:var(--text-dim);
    font-family:'Share Tech Mono',monospace;
    font-size:11px;
    padding:5px 10px;
    border-radius:4px;
    cursor:pointer;
  }
  button.ghost:hover{border-color:var(--neon-magenta);color:var(--neon-magenta);}

  .entry{
    background:var(--void-3);
    border:1px solid var(--line);
    border-radius:8px;
    padding:14px 16px;
    margin-bottom:10px;
  }
  .entry .entry-head{
    display:flex;justify-content:space-between;align-items:center;
    margin-bottom:8px;
  }
  .entry .date{
    font-family:'Share Tech Mono',monospace;
    font-size:12px;
    color:var(--neon-cyan);
  }
  .entry .body{font-size:15px;line-height:1.55;color:var(--text);white-space:pre-wrap;}
  .empty-state{
    text-align:center;color:var(--chrome-dim);
    font-family:'Share Tech Mono',monospace;
    font-size:13px;padding:30px 10px;
  }

  .rel-card{
    background:var(--void-3);
    border:1px solid var(--line);
    border-radius:8px;
    padding:14px 16px;
    margin-bottom:10px;
  }
  .rel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap;}
  .rel-name{font-weight:700;font-size:16px;}
  .rel-status{
    font-family:'Share Tech Mono',monospace;
    font-size:11px;
    padding:4px 10px;
    border-radius:20px;
    text-transform:uppercase;
    letter-spacing:1px;
    white-space:nowrap;
  }
  .status-freund{border:1px solid #4ee29d;color:#4ee29d;}
  .status-neutral{border:1px solid var(--chrome-dim);color:var(--chrome-dim);}
  .status-angespannt{border:1px solid #ffb84e;color:#ffb84e;}
  .status-feind{border:1px solid var(--neon-magenta);color:var(--neon-magenta);}
  .rel-role{color:var(--text-dim);font-size:13px;margin:4px 0 8px;}
  .rel-notes{font-size:14.5px;color:var(--text);line-height:1.5;}

  /* network graph */
  .net-wrap{
    background:var(--void-3);
    border:1px solid var(--line);
    border-radius:10px;
    padding:10px;
    margin-bottom:10px;
  }
  .net-node{cursor:pointer;}
  .net-node .ring{transition:filter .15s;}
  .net-node:hover .ring{filter:brightness(1.4);}
  .net-label{
    font-family:'Rajdhani',sans-serif;
    font-weight:600;
    font-size:13px;
    fill:var(--text);
    text-anchor:middle;
    pointer-events:none;
  }
  .net-initials{
    font-family:'Orbitron',sans-serif;
    font-size:16px;
    fill:#fff;
    text-anchor:middle;
    dominant-baseline:central;
    pointer-events:none;
  }

  .section-sub{
    font-family:'Orbitron',sans-serif;
    font-size:12px;
    letter-spacing:1.5px;
    color:var(--neon-purple);
    text-transform:uppercase;
    margin:26px 0 10px;
  }

  .img-upload-btn{
    display:flex;align-items:center;justify-content:center;
    background:var(--void);
    border:1px dashed var(--line);
    border-radius:6px;
    color:var(--text-dim);
    font-size:13.5px;
    cursor:pointer;
    padding:10px 12px;
    text-align:center;
  }
  .img-upload-btn:hover{border-color:var(--neon-cyan);color:var(--neon-cyan);}

  .char-detail{
    background:var(--void-3);
    border:1px solid var(--neon-purple);
    box-shadow:0 0 16px rgba(157,78,221,0.35);
    border-radius:10px;
    padding:16px;
    margin-bottom:22px;
    display:flex;
    gap:16px;
    align-items:flex-start;
  }
  .char-detail img.avatar-lg{
    width:72px;height:72px;border-radius:50%;object-fit:cover;
    border:2px solid var(--neon-cyan);flex-shrink:0;
  }
  .char-detail .avatar-lg.initials-lg{
    width:72px;height:72px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-family:'Orbitron',sans-serif;font-size:22px;color:#fff;
    border:2px solid var(--neon-cyan);flex-shrink:0;
  }
  .char-detail-body{flex:1;min-width:0;}
  .char-detail-close{
    background:none;border:none;color:var(--chrome-dim);
    font-family:'Share Tech Mono',monospace;font-size:12px;cursor:pointer;
    float:right;
  }
  .char-detail-close:hover{color:var(--neon-magenta);}

  .conn-item{
    background:var(--void-3);
    border:1px solid var(--line);
    border-radius:8px;
    padding:10px 14px;
    margin-bottom:8px;
    display:flex;justify-content:space-between;align-items:center;
    gap:10px;flex-wrap:wrap;
    font-size:14.5px;
  }
  .legend-row{
    display:flex;flex-wrap:wrap;gap:8px 14px;
    margin-top:18px;padding-top:14px;
    border-top:1px solid var(--line);
  }
  .legend-chip{
    display:flex;align-items:center;gap:6px;
    font-family:'Share Tech Mono',monospace;
    font-size:11px;color:var(--text-dim);
  }
  .legend-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
  .shared-note{
    font-family:'Share Tech Mono',monospace;
    font-size:12px;
    color:var(--neon-cyan);
    opacity:0.85;
    margin:6px 0 18px;
  }
  .sync-setup{
    background:var(--void-2);
    border:1px solid var(--neon-cyan);
    box-shadow:0 0 18px rgba(0,240,255,0.25);
    border-radius:10px;
    padding:22px;
    margin-bottom:24px;
  }
  .sync-setup-title{
    font-family:'Orbitron',sans-serif;
    font-size:14px;
    letter-spacing:1.5px;
    color:var(--neon-cyan);
    margin-bottom:10px;
  }
  .sync-setup p{color:var(--text-dim);font-size:14.5px;line-height:1.5;margin:0 0 14px;}
  .sync-id-box{
    font-family:'Share Tech Mono',monospace;
    font-size:16px;
    color:var(--neon-magenta);
    background:var(--void);
    border:1px dashed var(--neon-magenta);
    border-radius:6px;
    padding:12px 16px;
    letter-spacing:1px;
    word-break:break-all;
    user-select:all;
  }
  body.sync-pending nav.tabs, body.sync-pending .panel{ display:none !important; }

  .loading{text-align:center;color:var(--chrome-dim);font-family:'Share Tech Mono',monospace;padding:20px;}
  footer{
    text-align:center;margin-top:36px;
    font-family:'Share Tech Mono',monospace;
    font-size:11px;color:var(--chrome-dim);letter-spacing:1px;
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="sign">
    <div class="sign-frame">
      <h1>BURTON MC HAGGYS</h1>
      <div class="sub">Mechaniker · Hayes Auto Repair</div>
    </div>
    <div class="meta">Del Perro, Los Santos — Boston, MA (verlassen)</div>
  </div>

  <div id="syncSetup" class="sync-setup" style="display:none;">
    <div class="sync-setup-title">⚙ Einmalige Einrichtung nötig</div>
    <p>Damit dieses Tool von allen — auch ohne Claude-Konto — gemeinsam genutzt werden kann, braucht es einen kleinen, kostenlosen Cloud-Speicher.</p>
    <button class="action" onclick="createSyncStore()">Speicher erstellen</button>
    <div id="syncIdResult" style="display:none;margin-top:16px;">
      <p>Fertig! Schick diese ID im Chat an Claude, damit sie fest ins Tool eingebaut wird:</p>
      <div class="sync-id-box" id="syncIdBox"></div>
    </div>
  </div>

  <nav class="tabs">
    <button class="tab-btn active" data-tab="profil">Profil</button>
    <button class="tab-btn" data-tab="phrasen">Phrasenbank</button>
    <button class="tab-btn" data-tab="journal">Journal</button>
    <button class="tab-btn" data-tab="beziehungen">Beziehungen</button>
  </nav>

  <!-- PROFIL -->
  <section class="panel active" id="panel-profil">
    <div style="display:flex;justify-content:space-between;align-items:center;">
      <h2 class="panel-title" style="margin-bottom:0;">Charakterprofil</h2>
      <button class="ghost" id="profileEditBtn" onclick="toggleProfileEdit()">bearbeiten</button>
    </div>

    <div id="profileView"></div>

    <div id="profileEdit" class="entry-form" style="display:none;margin-top:16px;">
      <div class="form-row">
        <input type="text" id="pAlter" placeholder="Alter">
        <input type="text" id="pHerkunft" placeholder="Herkunft">
      </div>
      <div class="form-row">
        <input type="text" id="pBeruf" placeholder="Beruf">
        <input type="text" id="pWohnort" placeholder="Wohnort">
      </div>
      <h3 style="font-family:'Orbitron',sans-serif;font-size:12px;letter-spacing:1.5px;color:var(--neon-purple);text-transform:uppercase;margin:18px 0 8px;">Hintergrund</h3>
      <textarea id="pHintergrund" style="min-height:90px;"></textarea>
      <h3 style="font-family:'Orbitron',sans-serif;font-size:12px;letter-spacing:1.5px;color:var(--neon-purple);text-transform:uppercase;margin:18px 0 8px;">Wesen</h3>
      <textarea id="pWesen" style="min-height:90px;"></textarea>
      <input type="text" id="pTags" placeholder="Schlagworte, mit Komma getrennt (z.B. wortkarg, loyal, trockener Humor)">
      <h3 style="font-family:'Orbitron',sans-serif;font-size:12px;letter-spacing:1.5px;color:var(--neon-purple);text-transform:uppercase;margin:18px 0 8px;">Sprachmuster</h3>
      <textarea id="pSprache" style="min-height:80px;"></textarea>
      <div style="display:flex;gap:10px;margin-top:6px;">
        <button class="action" onclick="saveProfile()">Speichern</button>
        <button class="ghost" onclick="toggleProfileEdit()">Abbrechen</button>
      </div>
    </div>
  </section>

  <!-- PHRASEN -->
  <section class="panel" id="panel-phrasen">
    <h2 class="panel-title">Phrasenbank</h2>
    <div class="search-row">
      <input type="text" id="phraseSearch" placeholder="Suchen...">
      <select class="filter-select" id="phraseFilter">
        <option value="all">Alle Kategorien</option>
        <option value="werkstatt">Werkstatt</option>
        <option value="feierabend">Feierabend</option>
        <option value="familie">Familie</option>
        <option value="konflikt">Konflikt</option>
        <option value="reflex">Reflex / Flüche</option>
      </select>
    </div>
    <div id="phraseList"></div>
  </section>

  <!-- JOURNAL -->
  <section class="panel" id="panel-journal">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
      <h2 class="panel-title" style="margin-bottom:0;">Session-Journal</h2>
      <button class="ghost" onclick="managePin()">🔒 Bearbeiter-PIN</button>
    </div>
    <div class="shared-note">Geteilt — jeder mit diesem Link kann mitschreiben. Link nur privat mit deinen Mods teilen.</div>
    <div class="entry-form">
      <input type="text" id="journalAuthor" placeholder="Dein Name (z.B. Mod-Name)">
      <textarea id="journalText" placeholder="Was ist heute IC passiert? (z.B. neue Bekanntschaft, Auftrag, Vorfall...)"></textarea>
      <button class="action" onclick="addJournalEntry()">Eintrag speichern</button>
    </div>
    <div id="journalList"></div>
  </section>

  <!-- BEZIEHUNGEN -->
  <section class="panel" id="panel-beziehungen">
    <h2 class="panel-title">Beziehungsnetz</h2>
    <div class="shared-note">Geteilt — jeder mit diesem Link kann Charaktere & Verbindungen bearbeiten.</div>

    <div class="net-wrap">
      <svg id="netSvg" viewBox="0 0 640 640" style="width:100%;height:auto;max-height:560px;"></svg>
    </div>
    <div id="netEmpty" class="empty-state" style="display:none;">Noch keine Charaktere im Netz. Füg unten den ersten hinzu.</div>

    <div id="charDetail" class="char-detail" style="display:none;"></div>

    <h3 class="section-sub" id="charFormTitle">Charakter hinzufügen</h3>
    <div class="entry-form">
      <div class="form-row">
        <input type="text" id="relName" placeholder="Name">
        <input type="text" id="relRole" placeholder="Rolle (z.B. Kollege bei Hayes)">
      </div>
      <div class="form-row">
        <select id="relStatus"></select>
        <input type="text" id="relGroup" placeholder="Gruppe/Fraktion (z.B. Hayes Werkstatt, Vagos) — optional">
      </div>
      <div class="form-row">
        <label class="img-upload-btn">
          <span id="imgUploadLabel">Bild wählen (optional)</span>
          <input type="file" id="relImage" accept="image/*" style="display:none;" onchange="previewImage(event)">
        </label>
      </div>
      <img id="imgPreview" style="display:none;width:64px;height:64px;border-radius:50%;object-fit:cover;border:1px solid var(--line);margin-bottom:10px;">
      <textarea id="relNotes" placeholder="Notizen zur Beziehung..."></textarea>
      <button class="action" id="charFormSaveBtn" onclick="addRelationship()">Zum Netz hinzufügen</button>
      <button class="ghost" id="charFormCancelBtn" style="display:none;margin-left:8px;" onclick="cancelEditCharacter()">Abbrechen</button>
    </div>

    <h3 class="section-sub">Verbindung zwischen zwei Charakteren</h3>
    <div class="entry-form">
      <div class="form-row">
        <select id="connFrom"></select>
        <select id="connTo"></select>
      </div>
      <div class="form-row">
        <input type="text" id="connLabel" placeholder="Art der Verbindung (z.B. Bruder, Schulden)">
        <select id="connStatus"></select>
      </div>
      <button class="action" onclick="addConnection()">Verbindung speichern</button>
    </div>
    <div id="connList"></div>
