function previewImage(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    const img = new Image();
    img.onload = function(){
      const size = 160;
      const canvas = document.createElement('canvas');
      canvas.width = size; canvas.height = size;
      const ctx = canvas.getContext('2d');
      const scale = Math.max(size/img.width, size/img.height);
      const w = img.width*scale, h = img.height*scale;
      ctx.drawImage(img, (size-w)/2, (size-h)/2, w, h);
      pendingImage = canvas.toDataURL('image/jpeg', 0.82);
      document.getElementById('imgPreview').src = pendingImage;
      document.getElementById('imgPreview').style.display = 'inline-block';
      document.getElementById('imgUploadLabel').textContent = 'Bild ausgewählt ✓';
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

